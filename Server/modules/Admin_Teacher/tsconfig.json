{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
   "typeRoots": ["./src/types", "./node_modules/@types"],

    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
